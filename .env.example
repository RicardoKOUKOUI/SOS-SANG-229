# DOXAMI / SOS Sang 229 — local environment template
# Copy to `.env` (never commit `.env`).
# Names and comments only. Leave values empty or use clearly fake local placeholders.

# --- App ---
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Database (PostgreSQL) — used by Alembic / SQLAlchemy ---
# Example shape only (local): postgresql://sos_sang:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/sos_sang_229
# Leave empty until you run migrations. Never commit a real password.
DATABASE_URL=

# Matching radius in meters when hospital + donor both have GPS (default 15 km).
# City fallback is used when GPS is missing. Not a secret.
MATCH_RADIUS_METERS=15000

# --- Auth (JWT) — required for DOXAMI /auth routes ---
# Generate a long random string locally. Never reuse a real production secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Twilio SMS — not integrated yet (OTP / legacy alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional later: TWILIO_MESSAGING_SERVICE_SID=

# --- DOXAMI AI (Phase 7) — optional; leave empty = assistant unavailable ---
DOXAMI_AI_API_KEY=
DOXAMI_AI_BASE_URL=https://api.openai.com/v1
DOXAMI_AI_MODEL=gpt-4o-mini

# --- DOXAMI PSP (Phase 9) — optional; empty = no checkout / no payout ---
# A key does not move money: no payment adapter is shipped in this phase.
DOXAMI_PSP_API_KEY=

# --- Local Docker Postgres stub (docker-compose.yml) ---
POSTGRES_USER=sos_sang
POSTGRES_PASSWORD=
POSTGRES_DB=sos_sang_229
POSTGRES_PORT=5432
